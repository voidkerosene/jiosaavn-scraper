# JioSaavn Scrape API configuration
# Copy this file to .env and adjust as needed. Every variable is
# optional; the binary runs with defaults when unset.

# HTTP listen port (default 3000)
PORT=3000

# Optional additional log file; requests are also streamed to stdout.
# Leave empty (or omit entirely) for stdout-only logging.
LOG_FILE=logs/server.log

# Response cache lifetime in minutes (default 5)
CACHE_TTL_MINUTES=5

# Maximum number of cached responses before the cache is cleared
# wholesale (default 5000)
CACHE_MAX_SIZE=5000
